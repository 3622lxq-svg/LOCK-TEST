<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F7F8</item>
        <item name="android:navigationBarColor">#F7F7F8</item>
        <item name="android:colorAccent">#4F46E5</item>
    </style>

    <style name="AlarmTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#4F46E5</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
